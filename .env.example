# Copy to .env.local for dev. In prod these live in Railway (see ../docs/share-app-spec.md §9).

# SQLite path. On Railway this MUST be absolute inside the mounted volume, e.g. /data/lp-share.sqlite
SHARE_DB=./data/lp-share.sqlite

# Signs this app's own cookies + magic links (HMAC). 32+ random bytes. (Falls back to LINK_HUB_SECRET.)
SHARE_SECRET=dev-only-change-me-to-a-long-random-string

# Verifies LPOS staff tickets — the SAME value as SHARE_STAFF_SECRET in LPOS.
SHARE_STAFF_SECRET=dev-only-staff-secret-change-me

# LPOS → this app auth (push + pull), header x-lpos-token — SAME value as SHARE_APP_INGEST_TOKEN in LPOS.
LPOS_INGEST_TOKEN=dev-only-change-me-too

# Where "Open with LPOS" sends staff to pick up a staff pass.
LPOS_ORIGIN=http://localhost:3001

# Public origin of this app.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:4310

# R2 — presigning download links (a read-only token is enough). Same bucket LPOS writes share downloads to.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Magic-link email (Resend). Without a key, dev prints the link instead.
RESEND_API_KEY=
SHARE_MAIL_FROM=
